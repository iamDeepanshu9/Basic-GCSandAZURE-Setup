{
  "name": "fastify-gcs-service",
  "version": "1.0.0",
  "description": "Fastify service to upload files to Google Cloud Storage and generate signed URLs for download",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/app.test.ts",
    "azurite": "azurite --silent --skipApiVersionCheck --location .azurite"
  },
  "keywords": [
    "fastify",
    "gcs",
    "google-cloud-storage",
    "upload",
    "download",
    "signed-url"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@fastify/multipart": "^9.0.3",
    "@google-cloud/storage": "^7.15.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "azurite": "^3.37.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
